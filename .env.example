# All optional. Copy to .env to change them (the server loads .env if it exists).
PORT=3901
HOST=127.0.0.1
# Where signups.sqlite lives (default ./data).
DATA_DIR=./data
# Secret used to hash IP addresses before storing them. If unset, a random one is
# generated once and kept in DATA_DIR/ip-salt.
IP_SALT=
# Number of reverse proxies in front of this server (0 = none). Only set this when
# a proxy you control sets X-Forwarded-For.
TRUST_PROXY=0
